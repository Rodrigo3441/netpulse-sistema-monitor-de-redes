        <mxCell id="BWiKtT-6Y9iL_ukS4KQI-26" parent="1" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/database.svg;" value="api/v2/probes/probe_id/" vertex="1">
          <mxGeometry height="37" width="50" x="100" y="380" as="geometry" />
